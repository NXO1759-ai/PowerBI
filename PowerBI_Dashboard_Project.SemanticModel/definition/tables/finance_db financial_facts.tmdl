	measure 'Shares Outstanding Q LY' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			VAR yr =
				CALCULATE (
					MAX ( 'finance_db financial_facts'[fiscal_year] ),
					'finance_db companies'[ticker] = t
				)
			RETURN
				CALCULATE (
					[Shares Outstanding Q],
					'finance_db companies'[ticker] = t,
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_year] ),
					'finance_db financial_facts'[fiscal_year] = yr - 1
				)
		formatString: #,##0

	measure 'Gross Margin % Q' =
			DIVIDE ( [Gross Profit Q], [Revenue Q] )
		formatString: 0.0%

	measure 'Gross Margin % Q LY' =
			DIVIDE ( [Gross Profit Q LY], [Revenue Q LY] )
		formatString: 0.0%

	measure 'Working Capital Q' =
			[Current Assets Q] - [Current Liabilities Q]
		formatString: #,##0

	measure 'Working Capital Q LY' =
			[Current Assets Q LY] - [Current Liabilities Q LY]
		formatString: #,##0

	measure 'Net Cash Change Q' =
			[CF Ops Q] + [CF Inv Q] + [CF Fin Q]
		formatString: #,##0

	measure 'Net Cash Change Q LY' =
			[CF Ops Q LY] + [CF Inv Q LY] + [CF Fin Q LY]
		formatString: #,##0

	measure 'Monthly Burn Q' =
			DIVIDE ( [Net Cash Change Q], 3 )
		formatString: #,##0

	measure 'Monthly Burn Q LY' =
			DIVIDE ( [Net Cash Change Q LY], 3 )
		formatString: #,##0

	measure 'Remaining Cash Days Q' =
			VAR burn =
				[Monthly Burn Q]
			RETURN
				IF (
					ISBLANK ( burn ),
					BLANK (),
					IF (
						burn >= 0,
						"Infinite",
						FORMAT ( DIVIDE ( [Cash Q], - burn ) * 30, "#,##0" )
					)
				)

	measure 'Remaining Cash Days Q LY' =
			VAR burn =
				[Monthly Burn Q LY]
			RETURN
				IF (
					ISBLANK ( burn ),
					BLANK (),
					IF (
						burn >= 0,
						"Infinite",
						FORMAT ( DIVIDE ( [Cash Q LY], - burn ) * 30, "#,##0" )
					)
				)

	partition 'finance_db financial_facts' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("127.0.0.1", "finance_db", [ReturnSingleDatabase=true]),
				    finance_db_financial_facts = Source{[Schema="finance_db",Item="financial_facts"]}[Data]
				in
				    finance_db_financial_facts

	annotation PBI_ResultType = Table

