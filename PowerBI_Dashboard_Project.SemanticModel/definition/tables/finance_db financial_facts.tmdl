table 'finance_db financial_facts'
	lineageTag: 545ec1ab-057e-430e-a6a0-65ebe6469e17

	measure 'Revenue FY' =
			CALCULATE(
				SUM('finance_db financial_facts'[value]),
				'finance_db financial_facts'[concept] = "RevenueFromContractWithCustomerExcludingAssessedTax",
				'finance_db financial_facts'[fiscal_period] = "FY",
				'finance_db financial_facts'[unit] = "USD"
			)
		formatString: #,##0
		lineageTag: 2f140ed0-746a-444f-8b8d-b908d59e359f

	measure 'Net Income FY' =
			CALCULATE(
				SUM('finance_db financial_facts'[value]),
				'finance_db financial_facts'[concept] = "NetIncomeLoss",
				'finance_db financial_facts'[fiscal_period] = "FY",
				'finance_db financial_facts'[unit] = "USD"
			)
		formatString: #,##0
		lineageTag: 6fbf19cc-0a89-4b77-bc57-0360916cc1dd

	measure 'Net Margin %' = DIVIDE([Net Income FY], [Revenue FY])
		formatString: 0.0%
		lineageTag: caee397c-0833-4a5c-9b7f-13c36637e992

	measure 'Revenue Prev FY' =
			VAR yr = MAX('finance_db financial_facts'[fiscal_year])
			RETURN
				CALCULATE(
					[Revenue FY],
					REMOVEFILTERS('finance_db financial_facts'[fiscal_year]),
					'finance_db financial_facts'[fiscal_year] = yr - 1
				)
		formatString: #,##0
		lineageTag: bf1bc758-3161-468b-8e79-6a76fb79b4a7

	measure 'Revenue YoY %' = DIVIDE([Revenue FY] - [Revenue Prev FY], [Revenue Prev FY])
		formatString: 0.0%
		lineageTag: 178dfb92-14a3-40e1-a121-ca6b304a0aef

