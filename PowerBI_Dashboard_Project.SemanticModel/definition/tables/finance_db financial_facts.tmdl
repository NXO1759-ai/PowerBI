					'finance_db financial_facts'[concept] = "CostOfRevenue",
					'finance_db financial_facts'[unit] = "USD",
					'finance_db companies'[ticker] = t,
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_year] ),
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_period] ),
					'finance_db financial_facts'[fiscal_year] = yr,
					'finance_db financial_facts'[fiscal_period] = per
				)
			VAR prev =
				CALCULATE (
					SUM ( 'finance_db financial_facts'[value] ),
					'finance_db financial_facts'[concept] = "CostOfRevenue",
					'finance_db financial_facts'[unit] = "USD",
					'finance_db companies'[ticker] = t,
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_year] ),
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_period] ),
					'finance_db financial_facts'[fiscal_year] = yr,
