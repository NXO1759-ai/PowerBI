					)
				)
			VAR dei =
				CALCULATE (
					SUM ( 'finance_db financial_facts'[value] ),
					'finance_db financial_facts'[concept] = "EntityCommonStockSharesOutstanding",
					'finance_db financial_facts'[unit] = "shares",
