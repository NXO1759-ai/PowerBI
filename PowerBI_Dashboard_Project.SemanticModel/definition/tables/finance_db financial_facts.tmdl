	measure 'Company Name' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			RETURN
				CALCULATE (
					MAX ( 'finance_db companies'[name] ),
					'finance_db companies'[ticker] = t
				)

	measure 'Ticker' =
			SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )

	measure 'Exchange' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			RETURN
				CALCULATE (
					MAX ( 'finance_db companies'[exchange] ),
					'finance_db companies'[ticker] = t
				)

	measure 'CIK' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			RETURN
				CALCULATE (
					MAX ( 'finance_db companies'[cik] ),
					'finance_db companies'[ticker] = t
				)
		formatString: 0

	measure 'Latest Filing Date' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			RETURN
				CALCULATE (
					MAX ( 'finance_db financial_facts'[filed_date] ),
					'finance_db companies'[ticker] = t
				)
		formatString: Short Date

	measure 'Latest Filing Form' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			VAR d =
				CALCULATE (
					MAX ( 'finance_db financial_facts'[filed_date] ),
					'finance_db companies'[ticker] = t
				)
			RETURN
				CALCULATE (
					MAX ( 'finance_db financial_facts'[form] ),
					'finance_db companies'[ticker] = t
					'finance_db financial_facts'[filed_date] = d
				)

	measure 'Revenue Q' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			VAR yr =
				CALCULATE (
					MAX ( 'finance_db financial_facts'[fiscal_year] ),
					'finance_db companies'[ticker] = t
				)
			VAR per =
				IF (
					ISFILTERED ( 'finance_db financial_facts'[fiscal_period] ),
					MAX ( 'finance_db financial_facts'[fiscal_period] ),
					CALCULATE (
						MAX ( 'finance_db financial_facts'[fiscal_period] ),
						'finance_db companies'[ticker] = t,
						'finance_db financial_facts'[fiscal_year] = yr,
						'finance_db financial_facts'[fiscal_period] <> "FY"
					)
				)
			VAR prevper =
				SWITCH ( per, "Q2", "Q1", "Q3", "Q2" )
			VAR cur =
				CALCULATE (
					SUM ( 'finance_db financial_facts'[value] ),
					'finance_db financial_facts'[concept] = "RevenueFromContractWithCustomerExcludingAssessedTax",
					'finance_db financial_facts'[unit] = "USD",
					'finance_db companies'[ticker] = t,
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_year] ),
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_period] ),
					'finance_db financial_facts'[fiscal_year] = yr,
					'finance_db financial_facts'[fiscal_period] = per
				)
			VAR prev =
				CALCULATE (
					SUM ( 'finance_db financial_facts'[value] ),
					'finance_db financial_facts'[concept] = "RevenueFromContractWithCustomerExcludingAssessedTax",
					'finance_db financial_facts'[unit] = "USD",
					'finance_db companies'[ticker] = t,
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_year] ),
					REMOVEFILTERS ( 'finance_db financial_facts'[fiscal_period] ),
					'finance_db financial_facts'[fiscal_year] = yr,
					'finance_db financial_facts'[fiscal_period] = prevper
				)
			RETURN
				cur - prev
		formatString: #,##0

	measure 'COGS Q' =
			VAR t =
				SELECTEDVALUE ( 'finance_db companies'[ticker], "KBLB" )
			VAR yr =
